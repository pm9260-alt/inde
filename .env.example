# ------------------------------------------------------------------
# 街ポーカー 環境変数のひな形
#   このファイルを .env にコピーして、値を入れてください。
#   すべて空のままでも遊べます（地図は簡易表示・ランキングは端末内のみ）。
# ------------------------------------------------------------------

# Google マップを表示するためのキー
# 取得先: Google Cloud Console → APIとサービス → 認証情報
# 有効にする API: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# 任意。Google Cloud で Map ID を作った場合だけ設定します。
VITE_GOOGLE_MAPS_MAP_ID=

# ------------------------------------------------------------------
# 全員で共有するランキングを使う場合だけ設定します。
# 空にすると、ランキングはこの端末の中だけで集計されます。
# 取得先: Firebase コンソール → プロジェクトの設定 → 全般
# ------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_COLLECTION=machiPokerScores
